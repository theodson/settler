#!/usr/bin/env bash

set -a

BENTO_BRANCH="settler-homestead"
SETTLER_BRANCH="ubuntu-vmware-16"
HOMESTEAD_BRANCH="support/17"
UBUNTU_VERSION="24.04"

# Keep the bare version numbers before they are wrapped into the display
# strings below - the closing message needs them as arguments, not as prose.
SETTLER_VERSION_RAW="${SETTLER_VERSION:-16.0.0}"
HOMESTEAD_VERSION_RAW="${HOMESTEAD_VERSION:-17.0.4}"

SETTLER_VERSION="v${SETTLER_VERSION:-16.0.0} ( ${SETTLER_BRANCH} - Ubuntu ${UBUNTU_VERSION})"
HOMESTEAD_VERSION="Homestead v${HOMESTEAD_VERSION:-17.0.4} ( ${HOMESTEAD_BRANCH} )"
export PACKER_LOG=1
if [ -z "$DEBUG" ]; then
    # pass DEBUG=1 in env to enable debuging of packer build.
    export PACKER_LOG=0
fi

export vmbuild="$(realpath $(dirname $0)/../..)"
echo "base path: $vmbuild"

#
# clone repositories
#
if [ ! -e "$vmbuild/settler" ]; then
    pushd $vmbuild && git clone https://github.com/theodson/settler -b "${SETTLER_BRANCH}" && popd || {
        echo "✋  problem cloning settler repo"
        exit 1
    }
else
    echo "settler dir already exists : $vmbuild/settler"
    pushd $vmbuild/settler && git checkout "${SETTLER_BRANCH}" && popd || {
        echo "✋  problem switching branch"
        exit 1
    }
    #pushd $vmbuild/settler && git pull && popd || exit 1
fi

if [ ! -e "$vmbuild/bento" ]; then
    pushd $vmbuild && git clone https://github.com/chef/bento -b "${BENTO_BRANCH}" && popd || {
        echo "✋  problem cloning bento repo"
        exit 1
    }
else
    echo "bento dir already exists : $vmbuild/bento"
    pushd $vmbuild/bento && git checkout "${BENTO_BRANCH}" && popd || {
        echo "✋  problem switching branch"
        exit 1
    }
    pushd $vmbuild/bento && git pull && popd || exit 1
fi

if [ ! -e "$vmbuild/homestead" ]; then
    pushd $vmbuild && git clone https://github.com/theodson/homestead -b "${HOMESTEAD_BRANCH}" && popd || {
        echo "✋  problem cloning homestead repo"
        exit 1
    }
else
    echo "homestead dir already exists : $vmbuild/homestead"
        pushd $vmbuild/homestead && git checkout "${HOMESTEAD_BRANCH}" && popd || {
        echo "✋  problem switching branch"
        exit 1
    }
    #pushd $vmbuild/homestead && git pull && popd || exit 1
fi

settler_hash=$(pushd ../settler &>/dev/null && git rev-parse --short HEAD && popd &>/dev/null || return)
homestead_hash=$(pushd ../homestead &>/dev/null && git rev-parse --short HEAD && popd &>/dev/null || return)

SETTLER_VERSION="$SETTLER_VERSION $settler_hash"
HOMESTEAD_VERSION="$HOMESTEAD_VERSION $homestead_hash"
echo -e "\n$SETTLER_VERSION\n$HOMESTEAD_VERSION\n"

read -n1 -t30 -p "Reset settler and bento changes before build (Y/n)? " gitreset
gitreset=$(echo "${gitreset:-Y}"| tr "[:lower:]" "[:upper:]") # transform to uppercase and default to Y
echo

if [ "$gitreset" = 'Y' ]; then
    echo -e "⚡️ git reset"
    pushd "$vmbuild/settler" && git checkout scripts/amd64.sh scripts/arm.sh && popd || echo "could not reset settler"
    pushd "$vmbuild/bento" && rm -f packer_templates/settler.hcl && popd || echo "could not reset bento"
    pushd "$vmbuild/bento" && rm -f packer_templates/scripts/ubuntu/homestead_amd64.sh packer_templates/scripts/ubuntu/homestead_arm.sh && popd || echo "could not reset bento"
    pushd "$vmbuild/bento/packer_templates" && git checkout pkr-builder.pkr.hcl pkr-variables.pkr.hcl && popd || echo "could not reset bento"
fi

echo -e "⚡️ 5 seconds review pause"
sleep 5

#
# configure and make the vm
#
echo -e "⚡️ setup" &&
    pushd "$vmbuild/settler" &&
    source "$vmbuild/settler/bin/macos-sed-fix" &&
    bin/link-to-bento.sh &&
    # link in preparation for overriding the default vars defined in pkr-variables
    /bin/ln -f settler.hcl ../bento/packer_templates/settler.hcl &&
    bin/use-homestead-features.sh || {
        echo "✋ problem during setup!"
        exit 2
    }

# Splice the settler-firstboot service into the provisioning scripts, so the
# built box ships with it already installed and every deployed clone names
# itself on first boot. The definition lives in bin/vm-generalize.sh; this
# copies it in verbatim. Runs after the git reset above, and after
# use-homestead-features.sh, both of which rewrite scripts/*.sh.
echo -e "⚡️ firstboot service" &&
    bin/inject-firstboot.sh || {
        echo "✋ problem injecting the firstboot service!"
        exit 2
    }

if [ "$(uname -p)" = "arm" ]; then
    #var_file='os_pkrvars/ubuntu/ubuntu-22.04-aarch64.pkrvars.hcl'
    var_file='os_pkrvars/ubuntu/ubuntu-24.04-aarch64.pkrvars.hcl '
else
    #var_file='os_pkrvars/ubuntu/ubuntu-22.04-x86_64.pkrvars.hcl'
    var_file='os_pkrvars/ubuntu/ubuntu-24.04-x86_64.pkrvars.hcl'
fi

echo -e "⚡️ build" &&
    pushd "$vmbuild/bento" &&
    packer init -upgrade ./packer_templates
    packer build -on-error=ask -only=vmware-iso.vm -var-file=$var_file -var-file=packer_templates/settler.hcl ./packer_templates || {
        echo "✋  problem during build!"
        exit 3
    }

#
# the box is built - tell the operator how to turn it into something shippable
#
# packer's vagrant post-processor writes to builds/build_complete/, so recurse
built_box="$(find "$vmbuild/bento/builds" -name '*.vmware.box' -print0 2>/dev/null |
    xargs -0 ls -t 2>/dev/null | head -1)"

echo
echo "✅ build complete"
[ -n "$built_box" ] && echo "   📦 $built_box  ($(du -h "$built_box" | awk '{print $1}'))"
echo
echo "   Next - package it for distribution to the Mac mini fleet:"
echo
echo "       cd $vmbuild/settler && bash bin/package"
echo
echo "   That generalizes the guest (so every deployed copy gets its own"
echo "   hostname, machine-id and SSH host keys) and writes a double-clickable"
echo "   .vmwarevm plus a .dmg to settler/dist/."
echo "   See docs/packaging.md."
echo
echo "   Or, to test the box with Vagrant instead:"
echo "       bash bin/register-local-box.sh \"$built_box\" $HOMESTEAD_VERSION_RAW"


#echo -e "⚡️ build" &&
#    pushd "$vmbuild/bento/packer_templates/ubuntu" &&
#    packer build -only=vmware-iso ubuntu-20.04-amd64.json || {
#        echo "✋  problem during build!"
#        exit 3
#    }
